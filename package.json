{
  "name": "ksp-crime-decision-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "intelligence:demo": "node scripts/intelligence/run-demo.mjs",
    "intelligence:test": "node --test tests/intelligence/*.test.mjs",
    "schema:validate": "node scripts/schema/validate-schema.mjs",
    "schema:runbook": "node scripts/schema/generate-console-runbook.mjs",
    "schema:compare": "node scripts/schema/compare-catalyst-export.mjs",
    "intelligence-schema:validate": "node scripts/schema/validate-intelligence-schema.mjs",
    "intelligence-schema:runbook": "node scripts/schema/generate-intelligence-runbook.mjs",
    "compat:node18": "npx --yes node@18.20.8 --test tests/compat/node18-core.test.mjs",
    "compat:node24": "node --test tests/compat/node18-core.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ksp/intelligence-core": "file:packages/intelligence-core"
  }
}
